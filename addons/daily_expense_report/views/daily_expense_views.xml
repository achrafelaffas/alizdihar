<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view (inline editable) -->
    <record id="view_daily_expense_report_list" model="ir.ui.view">
        <field name="name">daily.expense.report.list</field>
        <field name="model">daily.expense.report</field>
        <field name="arch" type="xml">
            <list string="Daily Expense Report" editable="bottom" default_order="date desc">
                <field name="date"/>
                <field name="product_id"/>
                <field name="employee_id"/>
                <field name="entry" sum="Total Entry"/>
                <field name="purchase" sum="Total Purchase"/>
                <field name="wage" sum="Total Wage"/>
                <field name="other_expenses" sum="Total Other Expenses"/>
                <field name="lhaj_expenses" sum="Total Lhaj Expenses"/>
                <field name="rest" sum="Total Rest" readonly="1"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_daily_expense_report_form" model="ir.ui.view">
        <field name="name">daily.expense.report.form</field>
        <field name="model">daily.expense.report</field>
        <field name="arch" type="xml">
            <form string="Daily Expense Report">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="product_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="entry"/>
                            <field name="purchase"/>
                            <field name="wage"/>
                            <field name="other_expenses"/>
                            <field name="lhaj_expenses"/>
                            <field name="rest" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_daily_expense_report_search" model="ir.ui.view">
        <field name="name">daily.expense.report.search</field>
        <field name="model">daily.expense.report</field>
        <field name="arch" type="xml">
            <search string="Daily Expense Report">
                <field name="date"/>
                <field name="product_id"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date','&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <filter string="This Year" name="filter_this_year"
                        domain="[('date','&gt;=', context_today().strftime('%Y-01-01'))]"/>
                <separator/>
                <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}"/>
                <separator/>
                <filter string="Day" name="group_day" context="{'group_by':'date:day'}"/>
                <filter string="Month" name="group_month" context="{'group_by':'date:month'}"/>
                <filter string="Quarter" name="group_quarter" context="{'group_by':'date:quarter'}"/>
                <filter string="Year" name="group_year" context="{'group_by':'date:year'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_daily_expense_report" model="ir.actions.act_window">
        <field name="name">Daily Expense Report</field>
        <field name="res_model">daily.expense.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_daily_expense_report_search"/>
        <field name="context">{'search_default_group_day': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first daily expense report entry
            </p>
        </field>
    </record>

</odoo>
